                {
                    "text": "x = 4",
                    "isCorrect": true,
                    "feedback": "Correct! 2(4) + 5 = 13. The scale stays perfectly balanced."
                },
                {
                    "text": "x = 9",
                    "isCorrect": false,
                    "feedback": "Not quite! 2(9) + 5 = 23, which would tip the scale."
                },
                {
                    "text": "x = 8",
                    "isCorrect": false,
                    "feedback": "Check your math! 2(8) + 5 = 21, which unbalances the equation."
                }
            ]
        }
