        {
            "page": "challenge",
            "question": "A parabola has roots at x = 2 and x = −3. Where is the vertex?",
            "options": [
                {
                    "text": "At x = 2",
                    "isCorrect": false,
                    "feedback": "The vertex is between the roots, not at one of them."
                },
                {
                    "text": "At x = −0.5",
                    "isCorrect": true,
                    "feedback": "Correct! The vertex is always halfway between the roots."
                },
                {
                    "text": "At x = 0",
                    "isCorrect": false,
                    "feedback": "Close! The midpoint of 2 and −3 is (2 + (−3))/2 = −0.5"
                }
            ]
        }
